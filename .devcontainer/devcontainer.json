{
  "name": "MB Software House — Java 25 + Node.js 22",
  "image": "mcr.microsoft.com/devcontainers/java:25-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "nodeGypDependencies": true
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends curl jq python3 git-lfs && git lfs install && java -version && node --version && npm --version",
  "forwardPorts": [25565, 8080, 8081],
  "portsAttributes": {
    "25565": {
      "label": "Velocity — Minecraft",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Gaius WebSocket Bridge",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "Gaius Website",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },
  "remoteUser": "vscode"
}
