* text=auto eol=lf

# Source patches are applied byte for byte; never convert their line endings.
*.gpatch -text

*.jar binary
*.wasm binary

# Git LFS: large distributable/archive assets.
# Generated client output, official game files, and server runtime files remain ignored.
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
