# Gaius Client Runner — saved local settings
# This file is copied to port/runner.env on first launch.
# port/runner.env is ignored by Git and reused on future runs.

GAIUS_VERSION_PROFILE_PATH="versions/26.3.json"
GAIUS_RUNNER_BIND="0.0.0.0"
GAIUS_RUNNER_PORT="8081"

# 1 = compile before launch every time; 0 = launch the previous build only.
GAIUS_BUILD_ON_START="1"

# 16 GB Codespaces: 10g is a practical starting point, but compilation may
# still need more memory. Increase only if the Codespace has enough RAM.
GAIUS_TEAVM_MAX_HEAP="10g"
